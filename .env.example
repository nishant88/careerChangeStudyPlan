# Server Configuration
PORT=3001
NODE_ENV=development

# Daily Crawler Schedule (Cron expression, default: 07:00 AM daily)
CRAWLER_CRON=0 7 * * *

# Optional Custom Search API keys (Tavily, SerpAPI, or Google Custom Search)
# If left empty, LevelUp automatically uses high-authority tech RSS & curated live search endpoints.
SEARCH_API_KEY=
SERPAPI_KEY=
